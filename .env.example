# Set ONE of these in Vercel → Settings → Environment Variables. Never commit real keys.

# Google Gemini: free key from https://aistudio.google.com/apikey (no card)
GEMINI_API_KEY=
# Optional: pin a model instead of auto-picking the newest Flash, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=

# Or Anthropic: uses Claude Haiku
ANTHROPIC_API_KEY=
